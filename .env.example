# Copy to .env and fill in from your router's label. .env is git-ignored.
ROUTER_MODEL=
ROUTER_ADMIN_URL=
ROUTER_ADMIN_PASSWORD=
ROUTER_WIFI_SSID=
ROUTER_WIFI_KEY=
ROUTER_IMEI=
ROUTER_SERIAL=
ROUTER_SIM_NUMBER=
ROUTER_IP=
ROUTER_CELL_ID=
ROUTER_ENB=
ROUTER_SECTOR=
ROUTER_PCI=
ROUTER_TAC=
PHONE_MODEL=
PHONE_ADB_SERIAL=
PHONE_CELL_ID=
PHONE_ENB=
PHONE_SECTOR=
PHONE_TAC=
LAPTOP_WIFI_MAC=
DECODER_MODEL=

# Game Boost test servers (host:port, comma separated). Empty = defaults.
BOOST_TARGETS=
# Tower map: free token from https://opencellid.org (optional)
OPENCELLID_KEY=
# Home position in decimal degrees, for tower distance/direction (optional)
HOME_LAT=
HOME_LON=
